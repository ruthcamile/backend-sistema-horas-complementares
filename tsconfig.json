{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": ".",
    "outDir": "./dist",
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@/*": ["src/*"]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": false,
    "skipLibCheck": true,
    "verbatimModuleSyntax": false,
    "types": ["node"]
    
  },

  "include": [
    "src/**/*" , 
    "prisma/**/*"
  ],
  "exclude": ["node_modules", "**/*.spec.ts"]

}