generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ALUNO
  COORDENADOR
}

enum StatusValidacao {
  PENDENTE
  APROVADO
  RECUSADO
}

model User {
  id           Int     @id @default(autoincrement())
  nome         String
  email        String  @unique
  senha        String
  role         Role    @default(ALUNO)
  matricula    String? @unique
  departamento String?
  
  // Relacionamento: Um aluno pode ter vários certificados
  certificados Certificado[]
  cursos       UsuariosCursos[] // ALTERADO: Aponta para a tabela intermediária explícita
}

model AreaAtividade {
  id              Int    @id @default(autoincrement())
  nome            String
  limiteHorasArea Float

  certificados    Certificado[]
  subcategorias   Subcategoria[]
}

// Adicionando o modelo de Curso
model Curso {
  id           Int           @id @default(autoincrement())
  nome         String
  
  // Aponta para a tabela intermediária explícita
  alunos       UsuariosCursos[]      
  
  // Relacionamento 1:N com Certificado
  certificados Certificado[] 
}

// Novo modelo (Tabela Pivô Explícita)
model UsuariosCursos {
  usuarioId Int
  cursoId   Int

  // Relações
  usuario   User  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  curso     Curso @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  // CHAVE PRIMÁRIA COMPOSTA COMPATÍVEL COM AIVEN / MYSQL
  @@id([usuarioId, cursoId])
}

// Adicionando o modelo de Subcategoria
model Subcategoria {
  id              Int           @id @default(autoincrement())
  nome            String
  
  areaId          Int
  area            AreaAtividade @relation(fields: [areaId], references: [id])
  
  certificados    Certificado[]
}

model Certificado {
  id                    Int      @id @default(autoincrement())
  tituloAtividade       String
  cargaHorariaInformada Float
  dataAtividade         DateTime
  arquivoImagem         String
  dataEnvio             DateTime @default(now())

  // Relacionamento com o Aluno
  alunoId Int
  aluno   User @relation(fields: [alunoId], references: [id])

  // Relacionamento com a Área de Atividade
  areaId  Int
  area    AreaAtividade @relation(fields: [areaId], references: [id])

  // Relacionamentos obrigatórios das novas tabelas
  cursoId        Int
  curso          Curso         @relation(fields: [cursoId], references: [id])
  
  subcategoriaId Int
  subcategoria   Subcategoria  @relation(fields: [subcategoriaId], references: [id])

  // Relacionamento 1:1 com a Validação
  validacao Validacao?
}

model Validacao {
  id             Int             @id @default(autoincrement())
  status         StatusValidacao @default(PENDENTE)
  observacao     String?         @db.Text
  horasValidadas Float?
  dataValidacao  DateTime?

  certificadoId  Int             @unique
  certificado    Certificado     @relation(fields: [certificadoId], references: [id])
}