generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int           @id @default(autoincrement())
  nome         String
  email        String        @unique
  senha        String
  role         Role          @default(ALUNO)
  matricula    String?       @unique
  departamento String?
  cursos       CursosNoUser[]
  certificados Certificado[]
}

model AreaAtividade {
  id              Int           @id @default(autoincrement())
  nome            String
  limiteHorasArea Float
  certificados    Certificado[]
}

model Certificado {
  id                    Int           @id @default(autoincrement())
  tituloAtividade       String
  cargaHorariaInformada Float
  dataAtividade         DateTime
  arquivoImagem         String
  dataEnvio             DateTime      @default(now())
  alunoId               Int
  areaId                Int
  aluno                 User          @relation(fields: [alunoId], references: [id])
  area                  AreaAtividade @relation(fields: [areaId], references: [id])
  validacao             Validacao?

  @@index([alunoId], map: "Certificado_alunoId_fkey")
  @@index([areaId], map: "Certificado_areaId_fkey")
}

model Validacao {
  id             Int             @id @default(autoincrement())
  status         StatusValidacao @default(PENDENTE)
  observacao     String?         @db.Text
  horasValidadas Float?
  dataValidacao  DateTime?
  certificadoId  Int             @unique
  certificado    Certificado     @relation(fields: [certificadoId], references: [id])
}

model Curso {
  id                   BigInt @id @unique(map: "id") @default(autoincrement()) @db.UnsignedBigInt
  nome                 String @db.VarChar(255)
  total_horas_exigidas Int?   @default(200)
  usuarios             CursosNoUser[]
}

model CursosNoUser {
  userId  Int
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // ADICIONE @db.UnsignedBigInt AQUI PARA FICAR IGUAL AO ID DO CURSO:
  cursoId BigInt @db.UnsignedBigInt
  curso   Curso  @relation(fields: [cursoId], references: [id], onDelete: Cascade)

  @@id([userId, cursoId])
}

enum Role {
  ALUNO
  COORDENADOR
}

enum StatusValidacao {
  PENDENTE
  APROVADO
  RECUSADO
}
